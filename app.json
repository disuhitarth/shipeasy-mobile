{
  "expo": {
    "name": "ShipEasy Canada",
    "slug": "shipeasy-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "shipeasy",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#635BFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shipeasy.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your wallet with Face ID",
        "NSLocationWhenInUseUsageDescription": "Used to autofill shipping addresses",
        "NSPhotoLibraryUsageDescription": "Save shipping labels to your photos",
        "NSCameraUsageDescription": "Scan addresses and barcodes"
      }
    },
    "android": {
      "package": "com.shipeasy.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#635BFF"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-local-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "81108d87-5247-40fe-a4a4-255845452502"
      }
    },
    "owner": "disuhitarth-projects"
  }
}
