{
  "expo": {
    "name": "ShipEasy Canada",
    "slug": "shipeasy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "shipeasy",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#635BFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shipeasy.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your wallet with Face ID"
      }
    },
    "android": {
      "package": "com.shipeasy.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#635BFF"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-local-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
